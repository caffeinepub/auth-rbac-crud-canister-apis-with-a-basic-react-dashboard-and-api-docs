          "name": "List Tasks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"listTasks\",\n  \"args\": []\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Returns all tasks. Users see only their own tasks; admins see all tasks."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"listTasks\",\n  \"args\": []\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": "[\n  {\n    \"id\": \"task-123\",\n    \"owner\": \"2vxsx-fae\",\n    \"title\": \"Complete project proposal\",\n    \"description\": \"Draft and submit the Q1 project proposal\",\n    \"completed\": false,\n    \"priority\": \"high\",\n    \"dueDate\": 1740787200000000000,\n    \"tags\": [\"work\", \"urgent\", \"q1\"]\n  },\n  {\n    \"id\": \"task-456\",\n    \"owner\": \"2vxsx-fae\",\n    \"title\": \"Review code changes\",\n    \"description\": \"Review PR #42\",\n    \"completed\": true,\n    \"priority\": \"medium\",\n    \"dueDate\": null,\n    \"tags\": [\"code-review\"]\n  }\n]"
            }
          ]
        },
