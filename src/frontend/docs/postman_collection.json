    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"createTask\",\n  \"args\": [\n    \"task-123\",\n    \"Complete project proposal\",\n    \"Draft and submit the Q1 project proposal\",\n    \"high\",\n    1740787200000000000,\n    [\"work\", \"urgent\", \"q1\"]\n  ]\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Creates a new task with priority, due date, and tags. The authenticated user becomes the owner."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"createTask\",\n  \"args\": [\n    \"task-123\",\n    \"Complete project proposal\",\n    \"Draft and submit the Q1 project proposal\",\n    \"high\",\n    1740787200000000000,\n    [\"work\", \"urgent\", \"q1\"]\n  ]\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": "null"
            }
          ]
        },
        {
          "name": "Get Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"getTask\",\n  \"args\": [\"task-123\"]\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Retrieves a single task by ID. Users can only view their own tasks; admins can view all tasks."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"getTask\",\n  \"args\": [\"task-123\"]\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": "{\n  \"id\": \"task-123\",\n  \"owner\": \"2vxsx-fae\",\n  \"title\": \"Complete project proposal\",\n  \"description\": \"Draft and submit the Q1 project proposal\",\n  \"completed\": false,\n  \"priority\": \"high\",\n  \"dueDate\": 1740787200000000000,\n  \"tags\": [\"work\", \"urgent\", \"q1\"]\n}"
            }
          ]
        },
        {
          "name": "Update Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"updateTask\",\n  \"args\": [\n    \"task-123\",\n    \"Complete project proposal\",\n    \"Draft and submit the Q1 project proposal - updated\",\n    true,\n    \"medium\",\n    1740787200000000000,\n    [\"work\", \"completed\"]\n  ]\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Updates an existing task including priority, due date, and tags. Users can only update their own tasks; admins can update any task."
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"deleteTask\",\n  \"args\": [\"task-123\"]\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Deletes a task. Users can only delete their own tasks; admins can delete any task."
          }
        },
