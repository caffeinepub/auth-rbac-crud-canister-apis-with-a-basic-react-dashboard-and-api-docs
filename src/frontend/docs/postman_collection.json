          "name": "List Filtered Tasks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"listFilteredTasks\",\n  \"args\": [false, \"urgent\"]\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Returns filtered tasks based on completion status and optional tag filter. First parameter is showCompleted (boolean), second is tagFilter (string or null)."
          },
          "response": [
            {
              "name": "Active tasks with 'urgent' tag",
