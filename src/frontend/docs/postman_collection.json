  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Caller User Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"getCallerUserProfile\",\n  \"args\": []\n}"
            },
            "url": {
              "raw": "{{canister_url}}",
              "host": ["{{canister_url}}"]
            },
            "description": "Retrieves the profile of the authenticated user. Returns null if no profile exists."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"method\": \"getCallerUserProfile\",\n  \"args\": []\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": "{\n  \"name\": \"John Doe\",\n  \"role\": \"user\"\n}"
            }
          ]
        },
        {
          "name": "Save Caller User Profile",
          "request": {
            "method": "POST",
            "header": [
              {
